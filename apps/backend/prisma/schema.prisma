generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ==========================================
// ENUMS DEL DOMINIO
// ==========================================

enum UserRole {
  TENANT
  LANDLORD
  ADMIN

  @@map("user_role")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BLOCKED

  @@map("account_status")
}

enum PropertyType {
  APARTMENT
  HOUSE

  @@map("property_type")
}

enum PropertyStatus {
  AVAILABLE
  OCCUPIED
  DEACTIVATED

  @@map("property_status")
}

enum RuleType {
  PETS
  SMOKERS
  MAX_OCCUPANTS
  MIN_CONTRACT_DURATION

  @@map("rule_type")
}

enum SurveyTarget {
  TENANT
  PROPERTY

  @@map("survey_target")
}

enum LikeStatus {
  PENDING
  ACCEPTED
  REJECTED

  @@map("like_status")
}

enum RequestOrigin {
  SEARCH
  MATCH

  @@map("request_origin")
}

enum SenderRole {
  TENANT
  SYSTEM

  @@map("sender_role")
}

enum RequestStatus {
  ACTIVE
  CLOSED

  @@map("request_status")
}

enum VerificationTarget {
  USER
  PROPERTY

  @@map("verification_target")
}

enum VerificationStatus {
  PENDING
  UNMATCHED_TICKET
  APPROVED
  REJECTED

  @@map("verification_status")
}

enum ReportStatus {
  OPEN
  RESOLVED

  @@map("report_status")
}

enum LeaseStatus {
  PENDING
  ACTIVE
  ENDED

  @@map("lease_status")
}

enum RatingTarget {
  TENANT
  PROPERTY

  @@map("rating_target")
}

enum NotificationType {
  LIKE_RECEIVED
  MATCH
  VERIFICATION_RESULT
  SUSPENSION
  LEASE_CONFIRMATION
  NEW_MESSAGE

  @@map("notification_type")
}

enum InteractionAction {
  LIKE
  PASS
  ACCEPT
  REJECT
  MATCH
  REQUEST

  @@map("interaction_action")
}

// ==========================================
// 18 TABLAS PRINCIPALES DEL DOMINIO
// ==========================================

model User {
  id                   BigInt        @id @default(autoincrement())
  email                String        @db.VarChar(255)
  passwordHash         String?       @map("password_hash") @db.VarChar(255)
  googleId             String?       @map("google_id") @db.VarChar(100)
  fullName             String        @map("full_name") @db.VarChar(150)
  contact              String?       @db.VarChar(100)
  birthDate            DateTime?     @map("birth_date") @db.Date
  role                 UserRole
  status               AccountStatus @default(ACTIVE)
  verified             Boolean       @default(false)
  profileScore         Int?          @map("profile_score") @db.SmallInt
  mfaSecretEnc         String?       @map("mfa_secret_enc") @db.Text
  tokenVersion         Int           @default(1) @map("token_version")
  privacyPolicyVersion String?       @map("privacy_policy_version") @db.VarChar(50)
  acceptedAt           DateTime?     @map("accepted_at") @db.Timestamptz(6)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  anonymizedAt         DateTime?     @map("anonymized_at") @db.Timestamptz(6)

  properties             Property[]
  updatedScoringModels   ScoringModel[]
  updatedRankingWeights  RankingWeight[]
  surveyResponses        SurveyResponse[]
  likes                  Like[]
  officialRequests       OfficialRequest[]
  sentMessages           Message[]
  verificationRequests   VerificationRequest[] @relation("VerificationRequester")
  reviewedVerifications  VerificationRequest[] @relation("VerificationReviewer")
  filedReports           Report[]              @relation("ReportReporter")
  receivedReports        Report[]              @relation("ReportReported")
  handledReports         Report[]              @relation("ReportHandler")
  leases                 Lease[]
  authoredRatings        Rating[]              @relation("RatingAuthor")
  receivedRatings        Rating[]              @relation("RatingTenant")
  notifications          Notification[]
  interactionLogs        InteractionLog[]
  refreshTokens          RefreshToken[]
  pushTokens             UserPushToken[]
  dataDeletionRequests   DataDeletionRequest[]
  adminAuditLogs         AuditLog[]

  @@map("users")
}

model Property {
  id                BigInt                                @id @default(autoincrement())
  landlordId        BigInt                                @map("landlord_id")
  zoneId            BigInt?                               @map("zone_id")
  type              PropertyType
  address           String                                @db.VarChar(255)
  city              String                                @db.VarChar(100)
  neighborhood      String                                @db.VarChar(100)
  location          Unsupported("geography(Point, 4326)")?
  price             Decimal                               @db.Decimal(12, 2)
  bedrooms          Int                                   @db.SmallInt
  bathrooms         Int                                   @db.SmallInt
  amenities         String[]                              @default([])
  status            PropertyStatus                        @default(AVAILABLE)
  priceQualityScore Int?                                  @map("price_quality_score") @db.SmallInt
  verified          Boolean                               @default(false)
  createdAt         DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  landlord             User                  @relation(fields: [landlordId], references: [id])
  zone                 BogotaZone?           @relation(fields: [zoneId], references: [id])
  photos               PropertyPhoto[]
  rules                PropertyRule[]
  surveyResponses      SurveyResponse[]
  likes                Like[]
  officialRequests     OfficialRequest[]
  verificationRequests VerificationRequest[]
  leases               Lease[]
  ratings              Rating[]
  interactionLogs      InteractionLog[]

  @@map("properties")
}

model PropertyPhoto {
  id         BigInt   @id @default(autoincrement())
  propertyId BigInt   @map("property_id")
  storageRef String   @map("storage_ref") @db.VarChar(500)
  position   Int      @default(0) @db.SmallInt
  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_photos")
}

model PropertyRule {
  id         BigInt   @id @default(autoincrement())
  propertyId BigInt   @map("property_id")
  ruleType   RuleType @map("rule_type")
  value      String   @db.VarChar(100)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_rules")
}

model ScoringModel {
  id        BigInt       @id @default(autoincrement())
  target    SurveyTarget
  version   Int
  weights   Json         @db.JsonB
  active    Boolean      @default(false)
  updatedBy BigInt       @map("updated_by")
  updatedAt DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)

  updater         User             @relation(fields: [updatedBy], references: [id])
  surveyResponses SurveyResponse[]

  @@map("scoring_models")
}

model RankingWeight {
  id            BigInt   @id @default(autoincrement())
  scoreWeight   Decimal  @map("score_weight") @db.Decimal(5, 2)
  verifiedBonus Decimal  @map("verified_bonus") @db.Decimal(5, 2)
  starsWeight   Decimal  @default(0) @map("stars_weight") @db.Decimal(5, 2)
  active        Boolean  @default(false)
  updatedBy     BigInt   @map("updated_by")
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  updater User @relation(fields: [updatedBy], references: [id])

  @@map("ranking_weights")
}

model SurveyResponse {
  id             BigInt       @id @default(autoincrement())
  target         SurveyTarget
  tenantId       BigInt?      @map("tenant_id")
  propertyId     BigInt?      @map("property_id")
  scoringModelId BigInt       @map("scoring_model_id")
  answers        Json         @db.JsonB
  resultingScore Int          @map("resulting_score") @db.SmallInt
  completedAt    DateTime     @default(now()) @map("completed_at") @db.Timestamptz(6)

  tenant       User?        @relation(fields: [tenantId], references: [id])
  property     Property?    @relation(fields: [propertyId], references: [id])
  scoringModel ScoringModel @relation(fields: [scoringModelId], references: [id])

  @@map("survey_responses")
}

model Like {
  id             BigInt     @id @default(autoincrement())
  tenantId       BigInt     @map("tenant_id")
  propertyId     BigInt     @map("property_id")
  status         LikeStatus @default(PENDING)
  rulesConfirmed Boolean    @map("rules_confirmed")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  decidedAt      DateTime?  @map("decided_at") @db.Timestamptz(6)

  tenant   User     @relation(fields: [tenantId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])
  match    Match?

  @@unique([tenantId, propertyId])
  @@map("likes")
}

model Match {
  id        BigInt   @id @default(autoincrement())
  likeId    BigInt   @unique @map("like_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  like            Like             @relation(fields: [likeId], references: [id])
  officialRequest OfficialRequest?

  @@map("matches")
}

model OfficialRequest {
  id             BigInt        @id @default(autoincrement())
  tenantId       BigInt        @map("tenant_id")
  propertyId     BigInt        @map("property_id")
  matchId        BigInt?       @unique @map("match_id")
  origin         RequestOrigin
  sentBy         SenderRole    @map("sent_by")
  status         RequestStatus @default(ACTIVE)
  rulesConfirmed Boolean       @map("rules_confirmed")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   User      @relation(fields: [tenantId], references: [id])
  property Property  @relation(fields: [propertyId], references: [id])
  match    Match?    @relation(fields: [matchId], references: [id])
  messages Message[]
  leases   Lease[]

  @@map("official_requests")
}

model Message {
  id                BigInt   @id @default(autoincrement())
  officialRequestId BigInt   @map("official_request_id")
  senderId          BigInt   @map("sender_id")
  clientMsgId       String?  @map("client_msg_id") @db.Uuid
  body              String   @db.Text
  showDisclaimer    Boolean  @default(false) @map("show_disclaimer")
  sentAt            DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)

  officialRequest OfficialRequest @relation(fields: [officialRequestId], references: [id], onDelete: Cascade)
  sender          User            @relation(fields: [senderId], references: [id])

  @@map("messages")
}

model VerificationRequest {
  id              BigInt             @id @default(autoincrement())
  ticketCode      String             @unique @map("ticket_code") @db.VarChar(32)
  requesterId     BigInt             @map("requester_id")
  target          VerificationTarget
  propertyId      BigInt?            @map("property_id")
  status          VerificationStatus @default(PENDING)
  reviewedBy      BigInt?            @map("reviewed_by")
  submittedAt     DateTime           @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedAt      DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason String?            @map("rejection_reason") @db.Text

  requester       User                    @relation("VerificationRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  property        Property?               @relation(fields: [propertyId], references: [id])
  reviewer        User?                   @relation("VerificationReviewer", fields: [reviewedBy], references: [id])
  documents       VerificationDocument[]
  gmailMessages   GmailIngestedMessage[]

  @@map("verification_requests")
}

model VerificationDocument {
  id                    BigInt   @id @default(autoincrement())
  verificationRequestId BigInt   @map("verification_request_id")
  fileName              String   @map("file_name") @db.VarChar(255)
  storageRef            String   @map("storage_ref") @db.VarChar(500)
  sha256Hash            String   @map("sha256_hash") @db.Char(64)
  mimeType              String   @map("mime_type") @db.VarChar(100)
  uploadedAt            DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  verificationRequest VerificationRequest @relation(fields: [verificationRequestId], references: [id], onDelete: Restrict)

  @@map("verification_documents")
}

model Report {
  id         BigInt       @id @default(autoincrement())
  reporterId BigInt       @map("reporter_id")
  reportedId BigInt       @map("reported_id")
  reason     String       @db.Text
  status     ReportStatus @default(OPEN)
  handledBy  BigInt?      @map("handled_by")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt DateTime?    @map("resolved_at") @db.Timestamptz(6)

  reporter User  @relation("ReportReporter", fields: [reporterId], references: [id])
  reported User  @relation("ReportReported", fields: [reportedId], references: [id])
  handler  User? @relation("ReportHandler", fields: [handledBy], references: [id])

  @@map("reports")
}

model Lease {
  id                BigInt      @id @default(autoincrement())
  officialRequestId BigInt      @map("official_request_id")
  tenantId          BigInt      @map("tenant_id")
  propertyId        BigInt      @map("property_id")
  startDate         DateTime    @map("start_date") @db.Date
  endDate           DateTime?   @map("end_date") @db.Date
  status            LeaseStatus @default(PENDING)
  tenantConfirmed   Boolean     @default(false) @map("tenant_confirmed")
  landlordConfirmed Boolean     @default(false) @map("landlord_confirmed")

  officialRequest OfficialRequest @relation(fields: [officialRequestId], references: [id])
  tenant          User            @relation(fields: [tenantId], references: [id])
  property        Property        @relation(fields: [propertyId], references: [id])
  ratings         Rating[]

  @@map("leases")
}

model Rating {
  id         BigInt       @id @default(autoincrement())
  leaseId    BigInt       @map("lease_id")
  authorId   BigInt       @map("author_id")
  target     RatingTarget
  tenantId   BigInt?      @map("tenant_id")
  propertyId BigInt?      @map("property_id")
  stars      Int          @db.SmallInt
  comment    String?      @db.Text
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  lease    Lease     @relation(fields: [leaseId], references: [id])
  author   User      @relation("RatingAuthor", fields: [authorId], references: [id])
  tenant   User?     @relation("RatingTenant", fields: [tenantId], references: [id])
  property Property? @relation(fields: [propertyId], references: [id])

  @@unique([leaseId, authorId])
  @@map("ratings")
}

model Notification {
  id        BigInt           @id @default(autoincrement())
  userId    BigInt           @map("user_id")
  type      NotificationType
  content   String           @db.Text
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model InteractionLog {
  id         BigInt            @id @default(autoincrement())
  userId     BigInt            @map("user_id")
  propertyId BigInt?           @map("property_id")
  action     InteractionAction
  result     String?           @db.VarChar(100)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id])
  property Property? @relation(fields: [propertyId], references: [id])

  @@map("interaction_logs")
}

// ==========================================
// TABLAS AUXILIARES Y GEOGRAFÍA (ARQUITECTURA.md)
// ==========================================

model BogotaZone {
  id                BigInt                                       @id @default(autoincrement())
  code              String                                       @unique @db.VarChar(32)
  localityName      String                                       @map("locality_name") @db.VarChar(100)
  upzName           String?                                      @map("upz_name") @db.VarChar(100)
  neighborhoodName  String                                       @map("neighborhood_name") @db.VarChar(120)
  geom              Unsupported("geography(MultiPolygon, 4326)")?
  centroid          Unsupported("geography(Point, 4326)")?
  referenceAvgPrice Decimal?                                     @map("reference_avg_price") @db.Decimal(12, 2)

  properties Property[]

  @@map("bogota_zones")
}

model RefreshToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model UserPushToken {
  id            BigInt   @id @default(autoincrement())
  userId        BigInt   @map("user_id")
  expoPushToken String   @unique @map("expo_push_token") @db.VarChar(255)
  platform      String   @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_push_tokens")
}

model DataDeletionRequest {
  id          BigInt    @id @default(autoincrement())
  userId      BigInt    @map("user_id")
  status      String    @default("PENDING") @db.VarChar(30)
  reason      String?   @db.Text
  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  deadlineAt  DateTime  @map("deadline_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("data_deletion_requests")
}

model GmailIngestedMessage {
  id               BigInt   @id @default(autoincrement())
  gmailMessageId   String   @unique @map("gmail_message_id") @db.VarChar(128)
  historyId        String   @map("history_id") @db.VarChar(64)
  senderEmail      String   @map("sender_email") @db.VarChar(255)
  matchedRequestId BigInt?  @map("matched_request_id")
  processedAt      DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  matchedRequest VerificationRequest? @relation(fields: [matchedRequestId], references: [id])

  @@map("gmail_ingested_messages")
}

model AuditLog {
  id             BigInt   @id @default(autoincrement())
  actorAdminId   BigInt   @map("actor_admin_id")
  action         String   @db.VarChar(80)
  targetType     String   @map("target_type") @db.VarChar(50)
  targetId       BigInt   @map("target_id")
  documentSha256 String?  @map("document_sha256") @db.Char(64)
  ipHash         String?  @map("ip_hash") @db.Char(64)
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  actorAdmin User @relation(fields: [actorAdminId], references: [id], onDelete: Restrict)

  @@map("audit_logs")
}
